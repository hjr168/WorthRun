.home-page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(108rpx + constant(safe-area-inset-bottom));
  padding: 28rpx 24rpx calc(108rpx + env(safe-area-inset-bottom));
  background: var(--wr-bg, #fbfaf7);
}

.home-intro {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  padding: 8rpx 8rpx 24rpx;
}

.season-title {
  color: var(--wr-text, #171512);
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
  line-height: 1.1;
}

.slogan {
  flex: 0 0 auto;
  padding-bottom: 6rpx;
  color: var(--wr-primary, #f2541b);
  font-size: 28rpx;
  font-style: italic;
  font-weight: 700;
  line-height: 1.4;
  white-space: nowrap;
}

.month-nav {
  display: flex;
  justify-content: space-around;
  border-bottom: 1rpx solid var(--wr-border, rgba(23, 21, 18, .12));
  margin-bottom: 26rpx;
}

.month-tab {
  position: relative;
  min-width: 96rpx;
  padding: 16rpx 18rpx 20rpx;
  color: var(--wr-muted, #6c6861);
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.month-tab.active {
  color: var(--wr-primary, #f2541b);
  font-weight: 800;
}

.month-tab.active::after {
  position: absolute;
  right: 14rpx;
  bottom: -2rpx;
  left: 14rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--wr-primary, #f2541b);
  content: '';
}

.focus-card,
.focus-empty,
.status-card,
.home-empty-state {
  border: 1rpx solid var(--wr-border, rgba(23, 21, 18, .12));
  border-radius: 24rpx;
  background: var(--wr-surface, #fff);
  box-shadow: 0 8rpx 24rpx rgba(44, 33, 21, .08);
}

.focus-swiper {
  width: 100%;
  height: 460rpx;
  border: 1rpx solid var(--wr-border, rgba(23, 21, 18, .12));
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--wr-surface-soft, #f5f2ed);
  box-shadow: 0 8rpx 24rpx rgba(44, 33, 21, .08);
}

.focus-slide {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.focus-slide.is-contained {
  box-shadow: inset 0 0 0 1rpx rgba(23, 21, 18, .06);
}

.focus-slide-image {
  display: block;
  width: 100%;
  height: 100%;
}

.focus-slide-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(to right, rgba(0, 0, 0, .82) 0%, rgba(0, 0, 0, .55) 38%, rgba(0, 0, 0, .15) 68%, transparent 100%);
  pointer-events: none;
}

.focus-slide-content {
  position: absolute;
  top: 50%;
  left: 36rpx;
  transform: translateY(-50%);
  display: flex;
  width: 60%;
  max-width: 440rpx;
  flex-direction: column;
  align-items: flex-start;
}

.focus-slide-label {
  align-self: flex-start;
  margin-bottom: 18rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--wr-primary, #f2541b);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
}

.focus-slide-title {
  display: -webkit-box;
  overflow: hidden;
  color: #fff;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.16;
  text-align: left;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .35);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.focus-slide-date {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, .96);
  font-size: 26rpx;
  font-weight: 700;
}

.focus-slide-distance {
  display: block;
  margin-top: 6rpx;
  color: rgba(255, 255, 255, .82);
  font-size: 24rpx;
}

.focus-slide-city {
  display: block;
  margin-top: 6rpx;
  color: rgba(255, 255, 255, .82);
  font-size: 24rpx;
}

.focus-slide-button {
  align-self: flex-start;
  width: auto;
  min-width: 0;
  height: 52rpx;
  margin-top: 22rpx;
  padding: 0 18rpx;
  line-height: 52rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--wr-primary, #f2541b);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.focus-slide-button::after {
  border: 0;
}

.focus-slide-attribution {
  position: absolute;
  right: 16rpx;
  bottom: 14rpx;
  max-width: calc(100% - 32rpx);
  overflow: hidden;
  border-radius: 8rpx;
  background: rgba(15, 25, 35, .6);
  color: rgba(255, 255, 255, .9);
  padding: 4rpx 10rpx;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.focus-empty-button,
.status-action,
.home-empty-button {
  min-height: 88rpx;
  margin-top: 22rpx;
}

.focus-empty,
.status-card,
.home-empty-state {
  padding: 44rpx 32rpx;
}

.focus-empty-kicker {
  color: var(--wr-primary, #f2541b);
  font-size: 24rpx;
  font-weight: 800;
}

.focus-empty-title,
.status-card-title,
.home-empty-title {
  display: block;
  margin-top: 12rpx;
  color: var(--wr-text, #171512);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
}

.focus-empty-copy,
.status-card-copy,
.home-empty-copy {
  display: block;
  margin-top: 12rpx;
  color: var(--wr-muted, #6c6861);
  font-size: 25rpx;
  line-height: 1.6;
}

.status-error {
  border-left: 8rpx solid var(--wr-primary, #f2541b);
}

.status-action,
.home-empty-button,
.focus-empty-button {
  width: 100%;
}

.status-feedback {
  min-height: 64rpx;
  margin-top: 8rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 34rpx 8rpx 16rpx;
}

.section-title {
  padding-left: 18rpx;
  border-left: 8rpx solid var(--wr-primary, #f2541b);
  color: var(--wr-text, #171512);
  font-size: 34rpx;
  font-weight: 900;
}

.section-more {
  min-height: 64rpx;
  color: var(--wr-muted, #6c6861);
  font-size: 24rpx;
  line-height: 64rpx;
}

.image-event-row {
  display: flex;
  gap: 22rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--wr-border, rgba(23, 21, 18, .12));
}

.row-image {
  flex: 0 0 245rpx;
  width: 245rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: var(--wr-surface-soft, #f5f2ed);
}

.row-image.is-contained,
.recommend-card image.is-contained {
  box-shadow: inset 0 0 0 1rpx rgba(23, 21, 18, .06);
}

.row-copy {
  min-width: 0;
  flex: 1;
  padding: 4rpx 0;
}

.row-title {
  display: -webkit-box;
  overflow: hidden;
  color: var(--wr-text, #171512);
  font-size: 29rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.row-meta {
  display: block;
  overflow: hidden;
  margin-top: 10rpx;
  color: var(--wr-muted, #6c6861);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.official-link {
  display: block;
  margin-top: 14rpx;
  color: var(--wr-primary, #f2541b);
  font-size: 25rpx;
  font-weight: 700;
}

.recommend-scroll {
  display: flex;
  width: 100%;
  white-space: nowrap;
}

.opening-list {
  display: flex;
  width: 100%;
  flex-direction: column;
}

.opening-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--wr-border, rgba(23, 21, 18, .12));
}

.opening-row:last-child {
  border-bottom: 0;
}

.opening-date {
  flex: 0 0 auto;
  min-width: 96rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--wr-primary-soft, #fff0e9);
  color: var(--wr-primary, #f2541b);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.opening-copy {
  min-width: 0;
  flex: 1;
}

.opening-name {
  display: -webkit-box;
  overflow: hidden;
  color: var(--wr-text, #171512);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.opening-city {
  display: block;
  margin-top: 6rpx;
  color: var(--wr-muted, #6c6861);
  font-size: 23rpx;
}

.recommend-city {
  margin-top: 8rpx;
  color: var(--wr-muted, #6c6861);
  font-size: 23rpx;
}

.recommend-card {
  display: inline-flex;
  width: 245rpx;
  margin-right: 18rpx;
  flex-direction: column;
  color: var(--wr-text, #171512);
  font-size: 25rpx;
  font-weight: 800;
  white-space: normal;
  word-break: break-all;
}

.recommend-card > text {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.recommend-card image {
  width: 245rpx;
  height: 140rpx;
  margin-bottom: 10rpx;
  border-radius: 14rpx;
  background: var(--wr-surface-soft, #f5f2ed);
}

.recommend-city {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 400;
}
