<theme-shell variant="home" show-search="{{true}}" show-region="{{true}}" bind:search="openEvents" bind:region="openRegion">
  <view class="page home-page">
    <view class="home-intro">
      <view class="season-title">秋季跑赛目的地</view>
      <text class="slogan">去一座城，跑一场</text>
    </view>

    <view class="month-nav" aria-label="选择月份">
      <view wx:for="{{monthTabs}}" wx:key="value" class="month-tab {{item.value === month ? 'active' : ''}}" data-month="{{item.value}}" bindtap="selectMonth" aria-label="{{item.label}}赛事">{{item.label}}</view>
    </view>

    <loading-state wx:if="{{loading}}" text="正在加载本月赛事" />
    <block wx:elif="{{error}}">
      <view class="status-card status-error">
        <text class="status-card-title">本月赛事暂时未能加载</text>
        <text class="status-card-copy">{{error}}</text>
        <button class="primary-button status-action" bindtap="reload">重新加载</button>
        <button class="plain-button status-feedback" bindtap="reportProblem">反馈问题</button>
      </view>
    </block>
    <block wx:else>
      <swiper wx:if="{{focusEvents.length}}" class="focus-swiper" autoplay="{{true}}" interval="4000" duration="500" circular="{{true}}" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,.45)" indicator-active-color="#f2541b" aria-label="本期焦点赛事轮播">
        <swiper-item wx:for="{{focusEvents}}" wx:key="id">
          <view class="focus-slide {{item.coverImageMode === 'aspectFit' ? 'is-contained' : ''}}" bindtap="openEvent" data-id="{{item.id}}" role="button" aria-label="查看焦点赛事 {{item.eventName}}">
            <image class="focus-slide-image" src="{{item.coverImageUrl}}" mode="{{item.coverImageMode || 'aspectFill'}}" binderror="onFocusImageError" data-index="{{index}}" aria-label="{{item.eventName}}赛事图片" />
            <view class="focus-slide-mask"></view>
            <view class="focus-slide-content">
              <text class="focus-slide-label">本期焦点</text>
              <text class="focus-slide-title">{{item.eventName}}</text>
              <text class="focus-slide-date">{{item.dateText}}</text>
              <text class="focus-slide-distance">{{item.distanceItems.join(' / ')}}</text>
              <text class="focus-slide-city">{{item.city}}</text>
              <button class="focus-slide-button" catchtap="openEvent" data-id="{{item.id}}" aria-label="查看焦点赛事">查看赛事</button>
            </view>
            <text wx:if="{{item.coverAttribution}}" class="focus-slide-attribution">图：{{item.coverAttribution}}</text>
          </view>
        </swiper-item>
      </swiper>
      <view wx:else class="focus-empty">
        <text class="focus-empty-kicker">本期焦点</text>
        <text class="focus-empty-title">等待一场值得出发的比赛</text>
        <text class="focus-empty-copy">赛事信息正在持续核验，先去全国赛事列表看看。</text>
        <button class="primary-button focus-empty-button" bindtap="openEvents">浏览全国赛事</button>
      </view>

      <block wx:if="{{editorsPicks.length}}">
        <view class="section-title-row"><text class="section-title">本月值得去</text><text class="section-more" bindtap="openEvents" role="button" aria-label="查看全部赛事">查看全部　›</text></view>
        <view class="event-list">
          <view wx:for="{{editorsPicks}}" wx:key="id" class="image-event-row" bindtap="openEvent" data-id="{{item.id}}" role="button" aria-label="查看赛事 {{item.eventName}}">
            <image class="row-image {{item.coverImageMode === 'aspectFit' ? 'is-contained' : ''}}" src="{{item.coverThumbnailUrl}}" mode="{{item.coverImageMode || 'aspectFill'}}" lazy-load="{{true}}" binderror="onEditorImageError" data-index="{{index}}" aria-label="{{item.eventName}}赛事图片" />
            <view class="row-copy"><text class="row-title">{{item.eventName}}</text><text class="row-meta">{{item.dateText}}　·　{{item.city}}</text><text class="row-meta">{{item.distanceItems.join(' / ')}}</text><text class="official-link">前往官方确认　›</text></view>
          </view>
        </view>
      </block>

      <block wx:if="{{signupSoon.length}}">
        <view class="section-title-row"><text class="section-title">即将开报</text><text class="section-more" bindtap="openEvents" role="button" aria-label="查看更多赛事">更多赛事　›</text></view>
        <view class="opening-list" aria-label="即将开报赛事"><view wx:for="{{signupSoon}}" wx:key="id" class="opening-row" bindtap="openEvent" data-id="{{item.id}}" role="button" aria-label="查看赛事 {{item.eventName}}"><text class="opening-date">{{item.signupStartAtText || '近期'}}</text><view class="opening-copy"><text class="opening-name">{{item.eventName}}</text><text class="opening-city">{{item.city}}</text></view></view></view>
      </block>

      <block wx:if="{{recommended.length}}">
        <view class="section-title-row"><text class="section-title">为你推荐</text></view>
        <scroll-view scroll-x="true" class="recommend-scroll" aria-label="推荐赛事"><view wx:for="{{recommended}}" wx:key="id" class="recommend-card" bindtap="openEvent" data-id="{{item.id}}" role="button"><image class="{{item.coverImageMode === 'aspectFit' ? 'is-contained' : ''}}" src="{{item.coverThumbnailUrl}}" mode="{{item.coverImageMode || 'aspectFill'}}" lazy-load="{{true}}" binderror="onRecommendedImageError" data-index="{{index}}" aria-label="{{item.eventName}}赛事图片" /><text>{{item.eventName}}</text><text class="recommend-city">{{item.city}} · {{item.dateText}}</text></view></scroll-view>
      </block>

      <view wx:if="{{!focusEvents.length && !editorsPicks.length && !signupSoon.length && !recommended.length}}" class="home-empty-state">
        <text class="home-empty-title">本月暂无已核验赛事</text>
        <text class="home-empty-copy">换一个月份，或前往赛事列表浏览全国赛事。</text>
        <button class="secondary-button home-empty-button" bindtap="openEvents">打开赛事列表</button>
      </view>
    </block>
  </view>
</theme-shell>
